<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla de espera: calco del splash del reproductor de PC (fondo blanco, logo al centro, rojo/negro). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <ImageView
            android:id="@+id/waiting_logo"
            android:layout_width="148dp"
            android:layout_height="148dp"
            android:layout_marginBottom="18dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_launcher_edulock" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/waiting_brand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.01"
                android:text="@string/waiting_brand"
                android:textColor="@color/text_primary"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:letterSpacing="0.01"
                android:text="@string/waiting_brand_accent"
                android:textColor="@color/brand_red"
                android:textSize="27sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="64dp"
            android:layout_height="4dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/rule_red" />

        <TextView
            android:id="@+id/waiting_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:text="@string/waiting_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/waiting_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/waiting_hint"
            android:textColor="@color/brand_red_deep"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/waiting_progress"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="22dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/brand_red"
            android:visibility="gone" />

        <Button
            android:id="@+id/waiting_courses"
            style="@style/Widget.Edulock.Button.Outline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="@string/courses_open"
            android:visibility="gone" />

        <Button
            android:id="@+id/waiting_catalog"
            style="@style/Widget.Edulock.Button.Outline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/resources_open_documents" />

    </LinearLayout>

    <Button
        android:id="@+id/waiting_logout"
        style="@style/Widget.Edulock.Button.Text.Muted"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="20dp"
        android:text="@string/btn_logout" />

</FrameLayout>
