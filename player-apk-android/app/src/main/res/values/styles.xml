<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema claro fijo (no cambia con el modo oscuro del teléfono): fondo blanco, texto negro, acento rojo. -->
    <style name="Theme.EdulockPlayer" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_red</item>
        <item name="colorPrimaryDark">@color/white</item>
        <item name="colorAccent">@color/brand_red</item>
        <item name="colorControlNormal">@color/text_secondary</item>
        <item name="colorControlActivated">@color/brand_red</item>
        <item name="colorControlHighlight">@color/ripple_red</item>
        <item name="colorButtonNormal">@color/brand_red</item>
        <item name="android:colorBackground">@color/white</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="buttonStyle">@style/Widget.Edulock.Button</item>
        <item name="android:buttonStyle">@style/Widget.Edulock.Button</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Edulock.Dialog</item>
        <item name="android:alertDialogTheme">@style/Theme.Edulock.FrameworkDialog</item>
        <item name="android:progressTint">@color/brand_red</item>
        <item name="android:indeterminateTint">@color/brand_red</item>
    </style>

    <style name="Theme.EdulockPlayer.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
    </style>

    <!-- Reproductor de video: negro (el video manda) -->
    <style name="Theme.EdulockPlayer.FullScreen">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:colorBackground">@color/black</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

    <!-- Botones -->
    <style name="Widget.Edulock.Button" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">22dp</item>
        <item name="android:paddingRight">22dp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Widget.Edulock.Button.Outline">
        <item name="android:background">@drawable/btn_outline</item>
        <item name="android:textColor">@color/brand_red</item>
    </style>
    <style name="Widget.Edulock.Button.Text">
        <item name="android:background">@drawable/btn_text</item>
        <item name="android:textColor">@color/brand_red_deep</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">40dp</item>
    </style>
    <style name="Widget.Edulock.Button.Text.Muted">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Diálogos (AppCompat y framework) blancos con acento rojo -->
    <style name="ThemeOverlay.Edulock.Dialog" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="colorAccent">@color/brand_red</item>
        <item name="colorPrimary">@color/brand_red</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:colorBackground">@color/white</item>
    </style>
    <style name="Theme.Edulock.FrameworkDialog" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/brand_red</item>
        <item name="android:colorPrimary">@color/brand_red</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:colorBackground">@color/white</item>
    </style>
</resources>
