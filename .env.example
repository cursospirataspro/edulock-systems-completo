# .env.example Edulock Systems — copia a .env y rellena con tus valores.
DATABASE_URL=postgresql://edulock:TU_PASSWORD@localhost:5432/campus_drm
PORT=3000
NODE_ENV=production
PUBLIC_URL=https://tu-dominio.dpdns.org
FIREBASE_PROJECT_ID=tu-proyecto-firebase
ADMIN_USER=tu-correo@ejemplo.com
ADMIN_PASS=CAMBIA_ESTA_CONTRASENA
JWT_SECRET=GENERA_64_HEX_node -e "require('crypto').randomBytes(48).toString('hex')"
JWT_EXPIRES_IN=2h
BUNNY_TOKEN_KEY=tu-bunny-token-key
APP_SECRET=GENERA_64_HEX
VDOCIPHER_API_SECRET=tu-vdocipher-secret-opcional
